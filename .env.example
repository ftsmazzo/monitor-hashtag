# Token do Apify (nunca commitar o valor real). Configure no EasyPanel em Ambiente.
APIFY_TOKEN=

# Banco Postgres do EasyPanel. Sem isso, grava em data/posts.json (só para teste local).
DATABASE_URL=

# Acesso ao painel (obrigatório em produção)
PAINEL_USUARIO=campanha
PAINEL_SENHA=

# Início da ação: só entra post publicado a partir daqui (horário de Brasília)
INICIO=2026-10-16T00:00:00-03:00

# Termos monitorados. Hashtags sem #, separadas por vírgula; frases separadas por vírgula.
HASHTAGS=lulaquebrouobrasil,lulauqebrouobrasil
FRASES=Lula quebrou o Brasil

# Quais redes coletar
REDES=x,tiktok,instagram

# Coleta automática a cada N minutos (0 desliga) e teto de itens por rede em cada rodada
INTERVALO_MIN=60
MAX_ITENS=300

# Teto de rodadas por dia por rede, para o custo não escapar
MAX_RODADAS_DIA=30

PORT=3000
